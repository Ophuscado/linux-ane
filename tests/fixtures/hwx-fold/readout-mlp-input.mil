program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3520.4.1"}, {"coremlc-version", "3520.5.1"}})]
{
    func main<ios18>(tensor<fp16, [1, 2048]> t7, tensor<fp16, [16, 128]> t2, tensor<fp16, [16, 128]> t0, tensor<fp16, [6144, 3]> t20) {
        tensor<fp16, [16, 128]> t1 = silu(x = t0)[name = string("t1")];
        tensor<fp16, [1, 128]> t3_g = const()[name = string("t3_g"), val = tensor<fp16, [1, 128]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(64)))];
        tensor<int32,[1]> t3_ax = const()[name=string("t3_ax"), val=tensor<int32,[1]>([1])];
        bool t3_kd = const()[name=string("t3_kd"), val=bool(true)];
        tensor<fp16, [16, 1]> t3_nrm = reduce_l2_norm(axes=t3_ax, keep_dims=t3_kd, x=t2)[name=string("t3_nrm")];
        fp16 t3_ep = const()[name=string("t3_ep"), val=fp16(0x1.72c0000000000p-7)];
        tensor<fp16, [16, 1]> t3_sn = maximum(x=t3_nrm, y=t3_ep)[name=string("t3_sn")];
        tensor<fp16, [16, 128]> t3_dv = real_div(x=t2, y=t3_sn)[name=string("t3_dv")];
        tensor<fp16, [16, 128]> t3 = mul(x=t3_dv, y=t3_g)[name=string("t3")];
        tensor<fp16, [16, 128]> t4 = mul(x = t3, y = t1)[name = string("t4")];
        tensor<int32, [2]> t5_sh = const()[name = string("t5_sh"), val = tensor<int32, [2]>([1, 2048])];
        tensor<fp16, [1, 2048]> t5 = reshape(shape = t5_sh, x = t4)[name = string("t5")];
        tensor<fp16, [2048, 2048]> t6_w = const()[name = string("t6_w"), val = tensor<fp16, [2048, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(384)))];
        tensor<fp16, [1, 2048]> t6 = matmul(transpose_x = bool(false), transpose_y = bool(true), x = t5, y = t6_w)[name = string("t6")];
        tensor<fp16, [1, 2048]> t8 = add(x = t7, y = t6)[name = string("t8")];
        tensor<fp16, [1, 2048]> t9_g = const()[name = string("t9_g"), val = tensor<fp16, [1, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(8389056)))];
        tensor<int32,[1]> t9_ax = const()[name=string("t9_ax"), val=tensor<int32,[1]>([1])];
        bool t9_kd = const()[name=string("t9_kd"), val=bool(true)];
        tensor<fp16, [1, 1]> t9_nrm = reduce_l2_norm(axes=t9_ax, keep_dims=t9_kd, x=t8)[name=string("t9_nrm")];
        fp16 t9_ep = const()[name=string("t9_ep"), val=fp16(0x1.72c0000000000p-5)];
        tensor<fp16, [1, 1]> t9_sn = maximum(x=t9_nrm, y=t9_ep)[name=string("t9_sn")];
        tensor<fp16, [1, 2048]> t9_dv = real_div(x=t8, y=t9_sn)[name=string("t9_dv")];
        tensor<fp16, [1, 2048]> t9 = mul(x=t9_dv, y=t9_g)[name=string("t9")];
        tensor<fp16, [6144, 2048]> t10_w = const()[name = string("t10_w"), val = tensor<fp16, [6144, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(8393216)))];
        tensor<fp16, [1, 6144]> t10 = matmul(transpose_x = bool(false), transpose_y = bool(true), x = t9, y = t10_w)[name = string("t10")];
        tensor<fp16, [6144, 2048]> t11_w = const()[name = string("t11_w"), val = tensor<fp16, [6144, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(33559104)))];
        tensor<fp16, [1, 6144]> t11 = matmul(transpose_x = bool(false), transpose_y = bool(true), x = t9, y = t11_w)[name = string("t11")];
        tensor<fp16, [1, 6144]> t12 = silu(x = t11)[name = string("t12")];
        tensor<fp16, [1, 6144]> t13 = mul(x = t12, y = t10)[name = string("t13")];
        tensor<fp16, [2048, 6144]> t14_w = const()[name = string("t14_w"), val = tensor<fp16, [2048, 6144]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(58724992)))];
        tensor<fp16, [1, 2048]> t14 = matmul(transpose_x = bool(false), transpose_y = bool(true), x = t13, y = t14_w)[name = string("t14")];
        tensor<fp16, [1, 2048]> t15 = add(x = t8, y = t14)[name = string("t15")];
        tensor<fp16, [6144, 4]> t16 = const()[name = string("t16"), val = tensor<fp16, [6144, 4]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(83890880)))];
        tensor<fp16, [1, 2048]> t17_g = const()[name = string("t17_g"), val = tensor<fp16, [1, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(83940096)))];
        tensor<int32,[1]> t17_ax = const()[name=string("t17_ax"), val=tensor<int32,[1]>([1])];
        bool t17_kd = const()[name=string("t17_kd"), val=bool(true)];
        tensor<fp16, [1, 1]> t17_nrm = reduce_l2_norm(axes=t17_ax, keep_dims=t17_kd, x=t15)[name=string("t17_nrm")];
        fp16 t17_ep = const()[name=string("t17_ep"), val=fp16(0x1.72c0000000000p-5)];
        tensor<fp16, [1, 1]> t17_sn = maximum(x=t17_nrm, y=t17_ep)[name=string("t17_sn")];
        tensor<fp16, [1, 2048]> t17_dv = real_div(x=t15, y=t17_sn)[name=string("t17_dv")];
        tensor<fp16, [1, 2048]> t17 = mul(x=t17_dv, y=t17_g)[name=string("t17")];
        tensor<fp16, [6144, 2048]> t18_w = const()[name = string("t18_w"), val = tensor<fp16, [6144, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(83944256)))];
        tensor<fp16, [1, 6144]> t18 = matmul(transpose_x = bool(false), transpose_y = bool(true), x = t17, y = t18_w)[name = string("t18")];
        tensor<int32, [2]> t19_sh = const()[name = string("t19_sh"), val = tensor<int32, [2]>([6144, 1])];
        tensor<fp16, [6144, 1]> t19 = reshape(shape = t19_sh, x = t18)[name = string("t19")];
        int32 t21_ax = const()[name = string("t21_ax"), val = int32(1)];
        bool t21_il = const()[name = string("t21_il"), val = bool(false)];
        tensor<fp16, [6144, 4]> t21 = concat(axis = t21_ax, interleave = t21_il, values = (t20, t19))[name = string("t21")];
        tensor<fp16, [6144, 4]> t22 = mul(x = t21, y = t16)[name = string("t22")];
        tensor<int32, [1]> t23_ax = const()[name = string("t23_ax"), val = tensor<int32, [1]>([1])];
        bool t23_kd = const()[name = string("t23_kd"), val = bool(true)];
        tensor<fp16, [6144, 1]> t23 = reduce_sum(axes = t23_ax, keep_dims = t23_kd, x = t22)[name = string("t23")];
        tensor<int32, [2]> t24_sh = const()[name = string("t24_sh"), val = tensor<int32, [2]>([1, 6144])];
        tensor<fp16, [1, 6144]> t24 = reshape(shape = t24_sh, x = t23)[name = string("t24")];
        tensor<fp16, [1, 6144]> t25 = silu(x = t24)[name = string("t25")];
        tensor<int32, [2]> t26_b = const()[name = string("t26_b"), val = tensor<int32, [2]>([0, 0])];
        tensor<int32, [2]> t26_sz = const()[name = string("t26_sz"), val = tensor<int32, [2]>([1, 2048])];
        tensor<fp16, [1, 2048]> t26 = slice_by_size(begin = t26_b, size = t26_sz, x = t25)[name = string("t26")];
        tensor<int32, [2]> t27_sh = const()[name = string("t27_sh"), val = tensor<int32, [2]>([16, 128])];
        tensor<fp16, [16, 128]> t27 = reshape(shape = t27_sh, x = t26)[name = string("t27")];
        tensor<fp16, [16, 16]> t28 = const()[name = string("t28"), val = tensor<fp16, [16, 16]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(109110144)))];
        tensor<fp16, [16, 128]> t29 = matmul(transpose_x = bool(false), transpose_y = bool(false), x = t28, y = t27)[name = string("t29")];
        tensor<int32,[1]> t30_ax = const()[name=string("t30_ax"), val=tensor<int32,[1]>([1])];
        bool t30_kd = const()[name=string("t30_kd"), val=bool(true)];
        tensor<fp16, [16, 1]> t30_nrm = reduce_l2_norm(axes=t30_ax, keep_dims=t30_kd, x=t29)[name=string("t30_nrm")];
        fp16 t30_ep = const()[name=string("t30_ep"), val=fp16(0x1.0640000000000p-10)];
        tensor<fp16, [16, 1]> t30_sn = maximum(x=t30_nrm, y=t30_ep)[name=string("t30_sn")];
        tensor<fp16, [16, 128]> t30 = real_div(x=t29, y=t30_sn)[name=string("t30")];
        fp16 t31_k = const()[name = string("t31_k"), val = fp16(0x1.6a00000000000p-4)];
        tensor<fp16, [16, 128]> t31 = mul(x = t30, y = t31_k)[name = string("t31")];
        tensor<int32, [2]> t32_b = const()[name = string("t32_b"), val = tensor<int32, [2]>([0, 2048])];
        tensor<int32, [2]> t32_sz = const()[name = string("t32_sz"), val = tensor<int32, [2]>([1, 2048])];
        tensor<fp16, [1, 2048]> t32 = slice_by_size(begin = t32_b, size = t32_sz, x = t25)[name = string("t32")];
        tensor<int32, [2]> t33_sh = const()[name = string("t33_sh"), val = tensor<int32, [2]>([16, 128])];
        tensor<fp16, [16, 128]> t33 = reshape(shape = t33_sh, x = t32)[name = string("t33")];
        tensor<fp16, [16, 128]> t34 = matmul(transpose_x = bool(false), transpose_y = bool(false), x = t28, y = t33)[name = string("t34")];
        tensor<int32,[1]> t35_ax = const()[name=string("t35_ax"), val=tensor<int32,[1]>([1])];
        bool t35_kd = const()[name=string("t35_kd"), val=bool(true)];
        tensor<fp16, [16, 1]> t35_nrm = reduce_l2_norm(axes=t35_ax, keep_dims=t35_kd, x=t34)[name=string("t35_nrm")];
        fp16 t35_ep = const()[name=string("t35_ep"), val=fp16(0x1.0640000000000p-10)];
        tensor<fp16, [16, 1]> t35_sn = maximum(x=t35_nrm, y=t35_ep)[name=string("t35_sn")];
        tensor<fp16, [16, 128]> t35 = real_div(x=t34, y=t35_sn)[name=string("t35")];
        tensor<int32, [2]> t36_b = const()[name = string("t36_b"), val = tensor<int32, [2]>([0, 4096])];
        tensor<int32, [2]> t36_sz = const()[name = string("t36_sz"), val = tensor<int32, [2]>([1, 2048])];
        tensor<fp16, [1, 2048]> t36 = slice_by_size(begin = t36_b, size = t36_sz, x = t25)[name = string("t36")];
        tensor<int32, [2]> t37_sh = const()[name = string("t37_sh"), val = tensor<int32, [2]>([16, 128])];
        tensor<fp16, [16, 128]> t37 = reshape(shape = t37_sh, x = t36)[name = string("t37")];
        tensor<fp16, [16, 2048]> t38_w = const()[name = string("t38_w"), val = tensor<fp16, [16, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(109110720)))];
        tensor<fp16, [1, 16]> t38 = matmul(transpose_x = bool(false), transpose_y = bool(true), x = t17, y = t38_w)[name = string("t38")];
        tensor<int32, [2]> t39_sh = const()[name = string("t39_sh"), val = tensor<int32, [2]>([1, 16])];
        tensor<fp16, [1, 16]> t39 = reshape(shape = t39_sh, x = t38)[name = string("t39")];
        tensor<fp16, [1, 16]> t40 = sigmoid(x = t39)[name = string("t40")];
        tensor<int32, [3]> t41_sh = const()[name = string("t41_sh"), val = tensor<int32, [3]>([16, 1, 1])];
        tensor<fp16, [16, 1, 1]> t41 = reshape(shape = t41_sh, x = t40)[name = string("t41")];
        tensor<fp16, [16]> t42 = const()[name = string("t42"), val = tensor<fp16, [16]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(109176320)))];
        tensor<fp16, [16]> t43 = const()[name = string("t43"), val = tensor<fp16, [16]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(109176416)))];
        tensor<fp16, [16, 2048]> t44_w = const()[name = string("t44_w"), val = tensor<fp16, [16, 2048]>(BLOBFILE(path = string("@model_path/weights.bin"), offset = uint64(109176512)))];
        tensor<fp16, [1, 16]> t44 = matmul(transpose_x = bool(false), transpose_y = bool(true), x = t17, y = t44_w)[name = string("t44")];
        tensor<int32, [2]> t45_sh = const()[name = string("t45_sh"), val = tensor<int32, [2]>([1, 16])];
        tensor<fp16, [1, 16]> t45 = reshape(shape = t45_sh, x = t44)[name = string("t45")];
        tensor<fp16, [1, 16]> t46 = add(x = t45, y = t43)[name = string("t46")];
        fp16 t47_c = const()[name = string("t47_c"), val = fp16(0x1.4000000000000p+3)];
        tensor<fp16, [1, 16]> t47_m = minimum(x = t46, y = t47_c)[name = string("t47_m")];
        tensor<fp16, [1, 16]> t47_s = softplus(x = t47_m)[name = string("t47_s")];
        fp16 t47_nc = const()[name = string("t47_nc"), val = fp16(-0x1.4000000000000p+3)];
        tensor<fp16, [1, 16]> t47_t = add(x = t46, y = t47_nc)[name = string("t47_t")];
        tensor<fp16, [1, 16]> t47_r = relu(x = t47_t)[name = string("t47_r")];
        tensor<fp16, [1, 16]> t47 = add(x = t47_s, y = t47_r)[name = string("t47")];
        tensor<fp16, [1, 16]> t48 = mul(x = t47, y = t42)[name = string("t48")];
        tensor<fp16, [1, 16]> t49 = exp(x = t48)[name = string("t49")];
        tensor<int32, [3]> t50_sh = const()[name = string("t50_sh"), val = tensor<int32, [3]>([16, 1, 1])];
