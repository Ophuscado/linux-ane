# omarchy-ane-level-dt install scriptlet. The device tree check between the markers is the single copy: package() extracts it
# into /usr/bin/omarchy-ane-level-check, and pre_install runs it, so the package never installs its overlay against a device
# tree the overlay was not written for.
#
# BEGIN-CHECK
_level_check() {
	# Read-only. The overlay t6001-ane-level.dts adds three properties to /soc/ane@285c04000 and names the kernel's power
	# controllers by raw phandle; each installed T6001 device tree of linux-aurora must have exactly that node and those
	# phandles, or the overlay would name the wrong power domains. OMARCHY_ANE_LEVEL_DTBS (one path per line) overrides
	# the list of device trees (tests).
	_dtbs=${OMARCHY_ANE_LEVEL_DTBS:-$(pacman -Qlq linux-aurora 2>/dev/null | grep '/dtbs/t6001-[^/]*\.dtb$' || true)}
	_rc=0
	if [ -z "$_dtbs" ]; then
		echo "omarchy-ane-level-check: no T6001 device tree of an installed linux-aurora package" >&2
		return 1
	fi
	command -v fdtget >/dev/null 2>&1 || { echo "omarchy-ane-level-check: fdtget (dtc) is not installed" >&2; return 1; }
	_pm=/soc/power-management@28e080000/power-controller
	for _dtb in $_dtbs; do
		_bad=""
		_n=/soc/ane@285c04000
		[ "$(fdtget -t s "$_dtb" $_n compatible 2>/dev/null)" = "apple,t6000-ane" ] || _bad="$_bad compatible"
		[ "$(fdtget -t s "$_dtb" $_n status 2>/dev/null)" = okay ] || _bad="$_bad status"
		[ "$(fdtget -t s "$_dtb" $_n reg-names 2>/dev/null)" = engine ] || _bad="$_bad reg-names"
		[ "$(fdtget -t x "$_dtb" $_n reg 2>/dev/null | tr -s ' ')" = "2 85c04000 0 24000" ] || _bad="$_bad reg"
		[ "$(fdtget -t x "$_dtb" $_n power-domains 2>/dev/null | tr -s ' ')" = "15 19 1a 1b 1c" ] || _bad="$_bad power-domains"
		for _e in 2c8:15:ane_sys_cpu c010:19:ane_set1 c018:1a:ane_set2 c020:1b:ane_set3 c028:1c:ane_set4 2e0:20:pms_sram; do
			_a=${_e%%:*}
			_r=${_e#*:}
			_p=${_r%%:*}
			_l=${_r#*:}
			[ "$(fdtget -t x "$_dtb" "$_pm@$_a" phandle 2>/dev/null)" = "$_p" ] || _bad="$_bad phandle@$_a"
			[ "$(fdtget -t s "$_dtb" "$_pm@$_a" label 2>/dev/null)" = "$_l" ] || _bad="$_bad label@$_a"
		done
		if [ -n "$_bad" ]; then
			echo "omarchy-ane-level-check: FAIL $_dtb:$_bad" >&2
			_rc=1
		else
			echo "omarchy-ane-level-check: ok $_dtb"
		fi
	done
	return $_rc
}
# END-CHECK

pre_install() {
	if ! _level_check; then
		echo "omarchy-ane-level-dt: the installed linux-aurora device trees do not match the overlay; not installing" >&2
		return 1
	fi
}

pre_upgrade() {
	pre_install
}

post_install() {
	echo "omarchy-ane-level-dt: omarchy-mac-boot rebuilds m1n1 stage 2 with this overlay (95-omarchy-mac-dtb-overlays.hook); reboot to use it."
	echo "  The overlay only matters with omarchy-ane-modules-aurora-12.6 (the ane driver that asks for level 1) and the PMP firmware running."
}

post_upgrade() {
	post_install
}
