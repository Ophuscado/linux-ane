        tensor<fp16, [1, 2048]> t51 = matmul(transpose_x = bool(false), transpose_y = bool(true), x = t17, y = t51_w)[name = string("t51")];
        tensor<int32, [2]> t52_sh = const()[name = string("t52_sh"), val = tensor<int32, [2]>([16, 128])];
        tensor<fp16, [16, 128]> t52 = reshape(shape = t52_sh, x = t51)[name = string("t52")];
        tensor<int32, [2]> t53_b = const()[name = string("t53_b"), val = tensor<int32, [2]>([0, 1])];
        tensor<int32, [2]> t53_sz = const()[name = string("t53_sz"), val = tensor<int32, [2]>([6144, 3])];
        tensor<fp16, [6144, 3]> t53 = slice_by_size(begin = t53_b, size = t53_sz, x = t21)[name = string("t53")];
    } -> (t15, t31, t35, t37, t41, t50, t52, t53);
